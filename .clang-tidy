# clang-tidy : static analysis, read by clangd in editors (see README.md).
# Whole families of checks, minus the ones that are matters of taste, or noise for this code base.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,

  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -performance-enum-size,
  -bugprone-easily-swappable-parameters,
  -bugprone-throwing-static-initialization,
  -cppcoreguidelines-avoid-const-or-ref-data-members,

  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,

  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-non-private-member-variables-in-classes

# Disabled above :
# - matters of taste : trailing return types, [[nodiscard]] everywhere, short names, magic numbers, enum sizes
# - noise : adjacent parameters of the same type, static initializations which could only throw bad_alloc,
#   const data members (intended, as in AppSettings::ConnectivityInfos)
# - low-level code (Win32, COM, WinHTTP) : pointer arithmetic, casts, unions and varargs of C APIs
# - duplicates of enabled checks : C arrays (modernize-avoid-c-arrays), public members (misc-non-private-member-variables-in-classes)

# our own headers only (not fetched dependencies)
HeaderFilterRegex: '.*[/\\](src|tests)[/\\].*'
ExcludeHeaderFilterRegex: '.*([/\\]_?deps[/\\]|iTunesCOMInterface).*'

CheckOptions:
  # bare boolean literals as arguments, as foo(true) : prefer an enum, or name it
  bugprone-argument-comment.CommentBoolLiterals: true
  # running out of memory ends the process anyway : allocations may throw where exceptions should not escape
  bugprone-exception-escape.IgnoredExceptions: 'bad_alloc,bad_array_new_length,length_error'
  # "if (done) return;" stays on one line
  readability-braces-around-statements.ShortStatementLines: 1
  readability-implicit-bool-conversion.AllowPointerConditions: true
  # umbrella headers whose symbols come from internal headers : C APIs (windows.h, WebView2.h...), and libc++ (<chrono> literals)
  misc-include-cleaner.IgnoreHeaders: 'include/[A-Za-z0-9_]+.h;__[a-z_]+/[a-z0-9_]+.h'
  # plain structs
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true

  # naming : PascalCase types and enum values, camelCase functions, variables and constants (ALL_CAPS is for
  # macros only, as Windows headers define many), "_" prefix for private and protected members
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.ConstexprVariableCase: camelBack
  readability-identifier-naming.ClassConstantCase: camelBack
  readability-identifier-naming.StaticConstantCase: camelBack
  readability-identifier-naming.GlobalConstantCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: '_'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: '_'
  readability-identifier-naming.PrivateMethodCase: camelBack
  readability-identifier-naming.PrivateMethodPrefix: '_'
  readability-identifier-naming.ProtectedMethodCase: camelBack
  readability-identifier-naming.ProtectedMethodPrefix: '_'
  # names given by Apple : the iTunes brand, and the identifiers of its COM SDK (iTunesCOMInterface)
  readability-identifier-naming.ClassIgnoredRegexp: '^iTunes.*'
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^(IID|CLSID|LIBID|DIID)_.*'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.IgnoreMainLikeFunctions: true
