{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceRoot}"
    },
    "tasks": [
        {
            "label": "0. Download submodules",
            "type": "shell",
            "command": "git submodule update --init --recursive",
            "problemMatcher": []
        },
        {
            "label": "1. Generate Project files (Debug)",
            "type": "shell",
            "windows": {
                "command": "cmake --preset windows-debug"
            },
            "osx": {
                "command": "cmake --preset macos-debug"
            },
            "problemMatcher": []
        },
        {
            "label": "1*. Generate Project files (Release)",
            "type": "shell",
            "windows": {
                "command": "cmake --preset windows-release"
            },
            "osx": {
                "command": "cmake --preset macos-release"
            },
            "problemMatcher": []
        },
        {
            "label": "2. Build (Debug)",
            "dependsOn": "1. Generate Project files (Debug)",
            "type": "shell",
            "windows": {
                "command": "cmake --build --preset windows-debug"
            },
            "osx": {
                "command": "cmake --build --preset macos-debug"
            },
            "problemMatcher": []
        },
        {
            "label": "2*. Build (Release)",
            "dependsOn": "1*. Generate Project files (Release)",
            "type": "shell",
            "windows": {
                "command": "cmake --build --preset windows-release"
            },
            "osx": {
                "command": "cmake --build --preset macos-release"
            },
            "problemMatcher": []
        },
        {
            "label": "2+. Run unit tests (Debug)",
            "type": "shell",
            "windows": {
                "command": "cmake --workflow --preset windows-test"
            },
            "osx": {
                "command": "cmake --workflow --preset macos-test"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "3. Package release, without publishing (Velopack)",
            "type": "shell",
            "windows": {
                "command": "cmake --workflow --preset windows-package"
            },
            "osx": {
                "command": "cmake --workflow --preset macos-package"
            },
            "problemMatcher": []
        },
        {
            "label": "4. Publish release (Velopack, GitHub)",
            "type": "shell",
            "windows": {
                "command": "cmake --workflow --preset windows-publish"
            },
            "osx": {
                "command": "cmake --workflow --preset macos-publish"
            },
            "problemMatcher": []
        },
        {
            "label": "BB. Generate .pfx file for Windows certification",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}/toolchains"
            },
            "command": "bash -x ./win_generate_pfx.sh"
        }
    ]
}