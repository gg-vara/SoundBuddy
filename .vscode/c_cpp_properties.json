{
    "configurations": [
        {
            "name": "MacOS-Silicon",
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "includePath": [
                "${default}",
                "${workspaceFolder}",
                "${workspaceFolder}/src",
                "${workspaceFolder}/build_debug/generated",
                "${workspaceFolder}/deps/ItunesLibraryParser/src",
                "${workspaceFolder}/build_debug/_deps/velopack-src/include",
                "/opt/homebrew/opt/qt/include",
                "/opt/homebrew/opt/qt/include/QtCore",
                "/opt/homebrew/opt/qt/include/QtWidgets",
                "/opt/homebrew/opt/qt/include/QtGui",
                "/opt/homebrew/opt/qt/include/QtNetwork",
                "/opt/homebrew/opt/qt/include/QtDBus"
            ]
        },
        {
            "name": "Win32",
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "windowsSdkVersion": "10.0.18362.0",
            "cStandard": "c11",
            "cppStandard": "c++20",
            "intelliSenseMode": "clang-x64",
            "compilerPath": "${env:MINGW64_ROOT}/bin/clang++.exe",
            "includePath": [
                "${default}",
                "${workspaceFolder}",
                "${workspaceFolder}/build_debug/generated",
                "${env:MINGW64_ROOT}/include",
                "${env:MINGW64_ROOT}/include/qt6",
                "${env:MINGW64_ROOT}/include/qt6/QtCore",
                "${env:MINGW64_ROOT}/include/qt6/QtWidgets",
                "${env:MINGW64_ROOT}/include/qt6/QtGui",
                "${env:MINGW64_ROOT}/include/qt6/QtNetwork",
                "${workspaceFolder}/deps/ItunesLibraryParser/src",
                "${workspaceFolder}/build_debug/_deps/velopack-src/include",
                "${env:MINGW64_ROOT}/include/c++/v1",
                "${env:MINGW64_ROOT}/lib/clang/22/include"
            ]
        }
    ],
    "version": 4
}