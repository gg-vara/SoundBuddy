{
    "terminal.integrated.profiles.windows": {
        "Msys2 Shell" : {
            "path" : "${env:MSYS2_ROOT}\\usr\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "MSYSTEM": "CLANG64",
                "MSYS2_PATH_TYPE": "inherit",
                "CHERE_INVOKING": "1",
                "MSVSCODE": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "Msys2 Shell",
    "terminal.integrated.scrollback": 10000,
    "search.exclude": {
        "deps" : false
    },

    // C++ code intelligence : clangd, from build_debug/compile_commands.json (see .clangd).
    // On macOS, set "clangd.path" in your user settings (/opt/homebrew/opt/llvm/bin/clangd)
    "clangd.path": "${env:MSYS2_ROOT}/clang64/bin/clangd.exe",
    "clangd.arguments": [
        // system headers of the MSYS2 / Homebrew compilers
        "--query-driver=**/clang++*",
        "--background-index",
        "--header-insertion=never"
    ],
    // the C/C++ extension only serves debugging ("cppdbg" launch configuration)
    "C_Cpp.intelliSenseEngine": "disabled",

    // CMake : configured from CMakePresets.json, never automatically.
    // On macOS, set "cmake.cmakePath" in your user settings (/opt/homebrew/bin/cmake)
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.cmakePath": "${env:MSYS2_ROOT}/clang64/bin/cmake.exe",

    // user interface page : Biome formats and fixes on save (src/ui/page/biome.json)
    "[typescript][typescriptreact][css][json]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.biome": "explicit",
            "source.organizeImports.biome": "explicit"
        }
    },

    // extension-less headers : the C++ standard library
    "files.associations": {
        "**/include/c++/v1/**": "cpp",
        "*.inc": "cpp",
        "*.ipp": "cpp"
    }
}
