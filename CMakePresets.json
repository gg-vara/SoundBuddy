{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "description": "MSYS2 CLANG64, MSYS2_ROOT environment variable must point to the MSYS2 installation (see README.md)",
            "toolchainFile": "${sourceDir}/toolchains/msys2.cmake",
            "environment": {
                "PATH": "$env{MSYS2_ROOT}/clang64/bin;$env{MSYS2_ROOT}/usr/bin;$penv{PATH}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "inherits": "base",
            "description": "Homebrew LLVM, APPLE_CODESIGN_ID and APPLE_CERT_APP_CODE_SIGN_IDENTITY environment variables must be set (see README.md)",
            "toolchainFile": "${sourceDir}/toolchains/osx.cmake",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows - Debug",
            "inherits": "windows",
            "binaryDir": "${sourceDir}/build_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SOUNDBUDDY_CODESIGN": "OFF",
                "SOUNDBUDDY_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows - Release, signed",
            "description": "Requires certs/all.pfx, generated by toolchains/win_generate_pfx.sh",
            "inherits": "windows",
            "binaryDir": "${sourceDir}/build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SOUNDBUDDY_CODESIGN": "ON"
            }
        },
        {
            "name": "windows-release-unsigned",
            "displayName": "Windows - Release, unsigned",
            "inherits": "windows-release",
            "binaryDir": "${sourceDir}/build_release_unsigned",
            "cacheVariables": {
                "SOUNDBUDDY_CODESIGN": "OFF"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS - Debug",
            "inherits": "macos",
            "binaryDir": "${sourceDir}/build_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SOUNDBUDDY_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS - Release",
            "inherits": "macos",
            "binaryDir": "${sourceDir}/build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-debug", "configurePreset": "windows-debug" },
        { "name": "windows-release", "configurePreset": "windows-release" },
        { "name": "windows-release-pack", "configurePreset": "windows-release", "targets": [ "velopack_pack" ] },
        { "name": "windows-release-publish", "configurePreset": "windows-release", "targets": [ "velopack_publish" ] },
        { "name": "windows-release-unsigned", "configurePreset": "windows-release-unsigned" },
        { "name": "windows-release-unsigned-pack", "configurePreset": "windows-release-unsigned", "targets": [ "velopack_pack" ] },
        { "name": "macos-debug", "configurePreset": "macos-debug" },
        { "name": "macos-release", "configurePreset": "macos-release" },
        { "name": "macos-release-pack", "configurePreset": "macos-release", "targets": [ "velopack_pack" ] },
        { "name": "macos-release-publish", "configurePreset": "macos-release", "targets": [ "velopack_publish" ] }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" },
            "filter": { "exclude": { "label": "network" } }
        },
        { "name": "windows-debug", "displayName": "Windows - unit tests", "inherits": "base", "configurePreset": "windows-debug" },
        { "name": "macos-debug", "displayName": "macOS - unit tests", "inherits": "base", "configurePreset": "macos-debug" }
    ],
    "workflowPresets": [
        {
            "name": "windows-test",
            "displayName": "Windows - build in Debug and run the unit tests",
            "steps": [
                { "type": "configure", "name": "windows-debug" },
                { "type": "build", "name": "windows-debug" },
                { "type": "test", "name": "windows-debug" }
            ]
        },
        {
            "name": "macos-test",
            "displayName": "macOS - build in Debug and run the unit tests",
            "steps": [
                { "type": "configure", "name": "macos-debug" },
                { "type": "build", "name": "macos-debug" },
                { "type": "test", "name": "macos-debug" }
            ]
        },
        {
            "name": "windows-package",
            "displayName": "Windows - build and package, unsigned (local check, nothing is published)",
            "steps": [
                { "type": "configure", "name": "windows-release-unsigned" },
                { "type": "build", "name": "windows-release-unsigned" },
                { "type": "build", "name": "windows-release-unsigned-pack" }
            ]
        },
        {
            "name": "windows-publish",
            "displayName": "Windows - build, package, sign and publish the GitHub release",
            "steps": [
                { "type": "configure", "name": "windows-release" },
                { "type": "build", "name": "windows-release" },
                { "type": "build", "name": "windows-release-pack" },
                { "type": "build", "name": "windows-release-publish" }
            ]
        },
        {
            "name": "macos-package",
            "displayName": "macOS - build and package (local check, nothing is published)",
            "steps": [
                { "type": "configure", "name": "macos-release" },
                { "type": "build", "name": "macos-release" },
                { "type": "build", "name": "macos-release-pack" }
            ]
        },
        {
            "name": "macos-publish",
            "displayName": "macOS - build, package and publish the GitHub release",
            "steps": [
                { "type": "configure", "name": "macos-release" },
                { "type": "build", "name": "macos-release" },
                { "type": "build", "name": "macos-release-pack" },
                { "type": "build", "name": "macos-release-publish" }
            ]
        }
    ]
}
